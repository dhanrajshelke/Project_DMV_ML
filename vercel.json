{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite"
    },
    "server": {
      "root": "server",
      "entrypoint": "Dockerfile.vercel",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "ML_SERVICE_URL"
        }
      ]
    },
    "app": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "ml-service/app.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/ml/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
