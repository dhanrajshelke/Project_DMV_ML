{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/ml/:path*",
      "destination": "https://cybersleuth-ml-api.onrender.com/api/ml/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://project-dmv-ml.onrender.com/api/:path*"
    }
  ]
}

